# Preferred location: backend/.env. Shell/deployment environment variables take precedence.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost
# Hosted Docker: APP_ENV=production, APP_ORIGIN=https://<your-service>.onrender.com,
# ALLOWED_HOSTS=<your-service>.onrender.com,127.0.0.1 (hostnames only).
# Render supplies PORT; the Docker image defaults to 8000 elsewhere.
# WEB_CONCURRENCY=1 controls API processes, not the separate AI worker.
SUPABASE_URL=https://gdyhnquqflgnjqlnhqog.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_f9KihvZ88fWBUd50fBx7bg_Bnhf8Y0E
# Runtime login must be restricted. Direct/admin credentials are for migrations only.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# DIRECT_URL is also accepted as the migration connection, for Supabase exports.
DIRECT_URL=
OPENROUTER_API_KEY=
# Optional overrides; normal model selection lives in backend/ai_models.json.
# AI_STANDARD_MODEL=qwen/qwen3.7-flash
# AI_ADVANCED_MODEL=z-ai/glm-5.3-flash
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hosted testing only: rzp_test_ keys + true permit admin checkout before merchant setup.
# Ignored for live keys. Leave false when accepting real payments.
RAZORPAY_ALLOW_TEST_CHECKOUT=false
# Bootstrap only; existing installations use Admin -> Product settings.
# Development/test environments with rzp_test_ keys do not need merchant policies or a webhook.
CHECKOUT_ENABLED=false
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_POLICY_URL=
REFUND_POLICY_URL=

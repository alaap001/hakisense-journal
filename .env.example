# Preferred location: backend/.env. Shell/deployment environment variables take precedence.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost
# Hosted Docker: APP_ENV=production, APP_ORIGIN=https://<your-service>.onrender.com,
# ALLOWED_HOSTS=<your-service>.onrender.com,127.0.0.1 (hostnames only).
# Render supplies PORT; the Docker image defaults to 8000 elsewhere.
# WEB_CONCURRENCY=1 controls API processes, not the separate AI worker.
SUPABASE_URL=https://gdyhnquqflgnjqlnhqog.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_f9KihvZ88fWBUd50fBx7bg_Bnhf8Y0E
# Runtime login must be restricted. Direct/admin credentials are for migrations only.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# DIRECT_URL is also accepted as the migration connection, for Supabase exports.
DIRECT_URL=
OPENROUTER_API_KEY=
